{
  "expo": {
    "name": "PeakHeight",
    "slug": "peakheightapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peakheight.app",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes for food nutrition information.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to let you share images in the Tribe community."
      },
      "notification": {
        "icon": "./assets/icon.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "notification": {
        "icon": "./assets/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.peakheight.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share images in the Tribe community."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
